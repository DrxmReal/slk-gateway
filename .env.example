# Upstream AI API URL
UPSTREAM_BASE_URL=https://api.hcnsec.cn/v1

# Upstream Secret API Key
UPSTREAM_API_KEY=your_upstream_api_key_here

# OpenCode & UnoRouter Keys (Optional)
OPENCODE_API_KEY=your_opencode_api_key_here
UNOROUTER_API_KEY=your_unorouter_api_key_here

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# (Optional) Master Custom Access Key
CUSTOM_ACCESS_KEY=

# (Optional) Admin secret cho Admin Pool (mặc định: slk-admin)
ADMIN_SECRET=

# Số dư tặng mỗi user mới khi đăng nhập Discord (Việt Nam Đồng)
DEFAULT_USER_BALANCE_VND=100000

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Local Server Port
PORT=3000
