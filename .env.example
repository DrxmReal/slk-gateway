# Upstream AI API URL
UPSTREAM_BASE_URL=https://api.hcnsec.cn/v1

# Upstream Secret API Key
UPSTREAM_API_KEY=your_upstream_api_key_here

# OpenCode & UnoRouter Keys (Optional)
OPENCODE_API_KEY=your_opencode_api_key_here
UNOROUTER_API_KEY=your_unorouter_api_key_here

# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# (Optional) Khóa ký bí mật API Key độc lập (khuyến nghị để tránh lộ key)
GATEWAY_SIGNING_SECRET=your_random_signing_secret_here

# (Optional) Master Custom Access Key
CUSTOM_ACCESS_KEY=

# (Bắt buộc nếu truy cập Admin Pool không qua Discord ID 1207080545159487498)
ADMIN_SECRET=your_super_strong_admin_secret_here

# Số dư tặng mỗi user mới khi đăng nhập Discord (Việt Nam Đồng)
DEFAULT_USER_BALANCE_VND=100000

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
# Khuyến nghị dùng service_role secret key cho Backend để bảo vệ RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Local Server Port
PORT=3000
